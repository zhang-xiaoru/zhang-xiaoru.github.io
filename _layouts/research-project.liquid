---
layout: page
---
<div class="research-detail">
  <a class="research-back" href="{{ '/research/' | relative_url }}#{{ page.area }}">&larr; Back to research</a>
  <p class="research-eyebrow">{{ page.methods }}</p>
  {% if page.img or page.image_placeholder %}
  <figure class="research-detail-figure">
    {% include research_figure.liquid placeholder=page.image_placeholder path=page.img alt=page.image_alt caption=page.caption loading='eager' %}
  </figure>
  {% endif %}
  {{ content }}
</div>
