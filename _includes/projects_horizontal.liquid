<div class="col-12 mb-4">
  <article class="card project-horizontal-card hoverable">
    <a class="project-horizontal-link{% unless project.img %} project-without-image{% endunless %}" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
      {% if project.img %}
        <div class="project-thumbnail">
          {% include figure.liquid loading="lazy" path=project.img sizes="(min-width: 768px) 260px, 90vw" alt=project.title class="project-thumbnail-img" %}
        </div>
      {% endif %}
      <div class="card-body">
        <h3 class="card-title">{{ project.title }}</h3>
        <p class="card-text">{{ project.description }}</p>
      </div>
    </a>
    {% if project.github %}
      <div class="project-repository">
        <a href="{{ project.github }}" aria-label="GitHub repository for {{ project.title | escape }}"><i class="fa-brands fa-github" aria-hidden="true"></i> Code repository</a>
        {% if project.github_stars %}
          <span class="stars" title="GitHub Stars"><i class="fa-solid fa-star" aria-hidden="true"></i> <span id="{{ project.github_stars }}-stars"></span></span>
        {% endif %}
      </div>
    {% endif %}
  </article>
</div>
