<li>
  <article class="research-card card h-100 hoverable">
    <a class="research-card project-card-link" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
      {% if project.img %}
        <div class="research-card-image">
          {% include research_figure.liquid path=project.img alt=project.title %}
        </div>
      {% endif %}
      <div class="research-card-body card-body">
        <h3 class="card-title">{{ project.title }}</h3>
        <p class="card-text">{{ project.description }}</p>
        <span class="research-card-link">Explore project <span aria-hidden="true">&rarr;</span></span>
      </div>
    </a>
    {% if project.github %}
      <div class="project-repository">
        <a href="{{ project.github }}" aria-label="GitHub repository for {{ project.title | escape }}"><i class="fa-brands fa-github" aria-hidden="true"></i> Code repository</a>
        {% if project.github_stars %}
          <span class="stars" title="GitHub Stars"><i class="fa-solid fa-star" aria-hidden="true"></i> <span id="{{ project.github_stars }}-stars"></span></span>
        {% endif %}
      </div>
    {% endif %}
  </article>
</li>
